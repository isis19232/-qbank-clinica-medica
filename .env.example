# ─────────────────────────────────────────────────────────────────
# Desenvolvimento (SQLite)
# ─────────────────────────────────────────────────────────────────
# DATABASE_URL="file:./dev.db"

# ─────────────────────────────────────────────────────────────────
# Produção (PostgreSQL — Vercel Postgres)
# ─────────────────────────────────────────────────────────────────
# Substitua pela sua connection string do Vercel Postgres ou outro PostgreSQL
# DATABASE_URL="postgresql://user:password@host:port/database?sslmode=require"

DATABASE_URL="file:./dev.db"

# ─────────────────────────────────────────────────────────────────
# Autenticação
# ─────────────────────────────────────────────────────────────────
# IMPORTANTE: Gere uma chave aleatória segura de 32 bytes em produção.
# Você pode usar: `openssl rand -base64 32`
AUTH_SECRET="dev-only-secret-change-me-in-production-0123456789abcdef"

# ─────────────────────────────────────────────────────────────────
# IA (Anthropic)
# ─────────────────────────────────────────────────────────────────
# Opcional. Sem chave, a camada de IA usa o provider offline determinístico.
# A aplicação funciona normalmente sem esta chave.
# ANTHROPIC_API_KEY="sk-ant-..."
AI_MODEL="claude-opus-5"

# ─────────────────────────────────────────────────────────────────
# Next.js
# ─────────────────────────────────────────────────────────────────
# NODE_ENV="production"
