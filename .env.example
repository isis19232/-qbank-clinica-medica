# PostgreSQL — local (Docker), Neon, Supabase, Vercel Postgres etc.
# Em produção, use a connection string fornecida pelo seu provedor de Postgres.
# Para desenvolvimento com SQLite: DATABASE_URL="file:./dev.db"
DATABASE_URL="postgresql://usuario:senha@localhost:5432/qbank?schema=public"

# AUTH_SECRET: Obrigatório em produção. Gere com: openssl rand -base64 32
# A sessão usa token opaco com hash SHA-256.
AUTH_SECRET="troque-por-uma-string-aleatoria-de-32-bytes"

# Opcional. Sem chave, a camada de IA usa o provider offline determinístico
# (sem geração de questões; tutor em modo degradado).
# ANTHROPIC_API_KEY=""

# Modelo de IA a usar (padrão: claude-opus-5)
AI_MODEL="claude-opus-5"
